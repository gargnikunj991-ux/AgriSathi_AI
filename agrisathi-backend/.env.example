# ===================================================================
# AgriSathi Backend Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ===================================================================

# Server Port
PORT=8080

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/agrisathidb
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Database Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=5

# JPA / Hibernate
DDL_AUTO=update
SHOW_SQL=true
FORMAT_SQL=true

# Security / JWT Secret Key (Generate a random 64-character hex string)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=1800000

# Cloudinary Integration Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging Levels
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
